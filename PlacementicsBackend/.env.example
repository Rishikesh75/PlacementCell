# Copy this file to .env and fill in real values.
# .env is gitignored. Do not commit secrets.

# --- PostgreSQL (Supabase) ---
# Direct connection. Username is postgres.
SUPABASE_DB_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres
SUPABASE_DB_PASSWORD=your-password

# If direct connection fails (often IPv6), use Session pooler from
# Supabase Dashboard → Database → Connection string (URI, session mode).
# Example for Mumbai (ap-south-1):
# SUPABASE_DB_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
# SUPABASE_DB_USERNAME=postgres.YOUR_PROJECT_REF

# --- MongoDB ---
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/?retryWrites=true&w=majority
MONGODB_DATABASE=placement_db

# --- JPA ---
# validate: schema must already exist (run DatabaseQueries/Creating Tables.sql).
JPA_DDL_AUTO=validate

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
